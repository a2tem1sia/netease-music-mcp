{
  "$schema": "./node_modules/@anthropic-ai/mcpb/schemas/mcpb-manifest-v0.4.schema.json",
  "manifest_version": "0.4",
  "name": "netease-music-mcp",
  "display_name": "网易云音乐（非官方）",
  "version": "0.1.1",
  "description": "非官方网易云音乐连接器：搜索歌曲/歌单/歌手、查看歌词和评论、排行榜、每日推荐、扫码登录、管理歌单。",
  "long_description": "通过网易云音乐网页版接口访问 music.163.com。未登录即可搜索、查看歌单 / 专辑 / 歌手 / 歌词 / 评论 / 排行榜；扫码登录（或填写 Cookie）后可以查看每日推荐、我喜欢的音乐、听歌排行，并新建歌单、往歌单里加歌、收藏歌曲。本项目与网易公司无关。",
  "author": {
    "name": "a2tem1sia",
    "url": "https://github.com/a2tem1sia"
  },
  "license": "MIT",
  "keywords": [
    "netease",
    "music",
    "网易云音乐",
    "163"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "NETEASE_COOKIE": "${user_config.netease_cookie}"
      }
    }
  },
  "user_config": {
    "netease_cookie": {
      "type": "string",
      "title": "网易云 Cookie（可选）",
      "description": "留空即可，安装后对 Claude 说“登录网易云”扫码登录。如果扫码被风控拦截，可以在这里填浏览器里 music.163.com 的 MUSIC_U 值（或完整 Cookie）。",
      "sensitive": true,
      "required": false
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=20.0.0"
    }
  },
  "tools_generated": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/a2tem1sia/netease-music-mcp"
  },
  "homepage": "https://github.com/a2tem1sia/netease-music-mcp",
  "support": "https://github.com/a2tem1sia/netease-music-mcp/issues"
}
